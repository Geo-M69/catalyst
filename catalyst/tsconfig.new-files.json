{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    "src/app/**/*.ts",
    "src/features/**/*.ts",
    "src/mainPage/detailsDropdownView.ts",
    "src/mainPage/downloadActivityView.ts",
    "src/mainPage/detailsDropdownMetadata.ts",
    "src/mainPage/libraryStatusView.ts",
    "src/mainPage/libraryViewRenderer.ts",
    "src/mainPage/stores/**/*.ts",
    "src/mainPage/storeMetadata.ts",
    "src/mainPage/steamArtwork.ts",
    "src/shared/**/*.ts"
  ]
}
